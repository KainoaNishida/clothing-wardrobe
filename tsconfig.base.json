{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "@cw/domain": ["./packages/domain/src"],
      "@cw/measurement": ["./packages/measurement/src"],
      "@cw/garments": ["./packages/garments/src"],
      "@cw/renderer": ["./packages/renderer/src"],
      "@cw/recommender": ["./packages/recommender/src"],
      "@cw/importer": ["./packages/importer/src"],
      "@cw/testing": ["./packages/testing/src"]
    }
  }
}
